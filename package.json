{
	"name": "better-surf",
	"version": "0.0.42",
	"private": true,
	"homepage": "https://github.com/hyunbinseo/better-surf#readme",
	"bugs": {
		"url": "https://github.com/hyunbinseo/better-surf/issues"
	},
	"license": "MIT",
	"author": "Hyunbin Seo",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hyunbinseo/better-surf.git"
	},
	"type": "module",
	"scripts": {
		"dev": "wxt",
		"dev:firefox": "wxt -b firefox --mv3",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox --mv3",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"postinstall": "wxt prepare",
		"postversion": "git push && git push --tags && node cli/postversion.ts"
	},
	"devDependencies": {
		"@lucide/svelte": "^1.38.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.3",
		"@tsconfig/svelte": "^5.0.8",
		"@types/node": "^24.13.3",
		"@types/qrcode-svg": "^1.1.5",
		"@wxt-dev/auto-icons": "^1.1.2",
		"@wxt-dev/module-svelte": "^2.0.5",
		"chrome-types": "^0.1.440",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"qrcode-svg": "^1.1.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"typescript": "^6.0.3",
		"valibot": "^1.4.2",
		"vite": "^8.2.2",
		"web-ext": "^10.6.0",
		"wxt": "^0.21.4"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.2.1",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "24.20.0",
			"onFail": "download"
		}
	}
}
