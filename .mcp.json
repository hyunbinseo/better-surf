{
	"mcpServers": {
		"chrome-devtools": {
			"type": "stdio",
			"command": "vpx",
			"args": ["chrome-devtools-mcp@latest", "--categoryExtensions", "--no-usage-statistics"]
		},
		"firefox-devtools": {
			"type": "stdio",
			"command": "vpx",
			"args": ["@mozilla/firefox-devtools-mcp@latest", "--headless", "--tool-preset", "developer"]
		}
	}
}
